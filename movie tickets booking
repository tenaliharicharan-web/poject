        .qty-controls { display: flex; align-items: center; gap: 8px; }
        .qty-btn {
            width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--accent-cyan);
            background: transparent; color: var(--accent-cyan); cursor: pointer; font-weight: bold;
        }

        .btn-checkout {
            font-family: 'Orbitron', sans-serif; font-size: 1.05rem; font-weight: 900;
            padding: 16px; background: linear-gradient(90deg, var(--accent-cyan), var(--accent-purple));
            border: none; border-radius: 50px; color: #ffffff; cursor: pointer; box-shadow: 0 0 25px var(--accent-cyan);
            transition: all 0.2s ease; margin-top: 20px; text-transform: uppercase;
