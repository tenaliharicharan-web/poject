        .seat-cell:hover { transform: scale(1.15); box-shadow: 0 0 12px var(--accent-cyan); }
        .seat-cell.selected { background: var(--accent-gold); border-color: var(--accent-gold); color: #000; font-weight: 900; }
        .seat-cell.corner { border-color: var(--accent-pink); }
        .seat-cell.occupied { background: rgba(255, 0, 85, 0.2); border-color: var(--accent-pink); color: #666; cursor: not-allowed; }

        /* Favorite Snacks Menu */
        .checkout-box {
            background: var(--card-bg);
            border: 1px solid var(--border-glow);
            border-radius: 20px;
            padding: 25px;
            display: flex; flex-direction: column; justify-content: space-between;
        }

        .snack-grid {
            display: flex; flex-direction: column; gap: 10px; margin-top: 10px;
