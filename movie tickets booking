                radial-gradient(circle at 90% 80%, rgba(0, 243, 255, 0.15) 0%, transparent 40%);
        }

        /* Header */
        header {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: 70px;
            padding: 0 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(7, 7, 18, 0.85);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-glow);
            z-index: 100;
        }

        .logo {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.6rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .main-container {
            margin-top: 90px;
            padding: 20px 40px;
            max-width: 1400px;
            margin-left: auto;
            margin-right: auto;
        }

        .section-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.6rem;
            font-weight: 800;
            margin-bottom: 15px;
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--accent-cyan);
        }

        /* Selection Controls Bar */
        .selection-panel {
            background: var(--card-bg);
            border: 1px solid var(--border-glow);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 30px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            backdrop-filter: blur(12px);
        }

        .control-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .control-label {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            color: #aaa;
            letter-spacing: 1px;
        }

        .select-input {
            background: rgba(10, 10, 25, 0.9);
            border: 1px solid var(--accent-cyan);
            color: #fff;
            padding: 10px 14px;
            border-radius: 10px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.95rem;
            outline: none;
        }

        /* Showtime Slots */
        .time-slots {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .time-slot-btn {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            padding: 8px 14px;
            border-radius: 20px;
            background: rgba(0, 243, 255, 0.1);
            border: 1px solid var(--accent-cyan);
            color: var(--accent-cyan);
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .time-slot-btn:hover, .time-slot-btn.active {
            background: var(--accent-cyan);
            color: #000;
            box-shadow: 0 0 15px var(--accent-cyan);
            font-weight: 900;
        }

        /* Movie Cards */
        .movies-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .movie-card {
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            overflow: hidden;
            cursor: pointer;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .movie-card:hover, .movie-card.selected {
            transform: translateY(-6px);
            border-color: var(--movie-theme-color);
            box-shadow: 0 0 25px var(--movie-theme-color);
        }

        .movie-poster {
            width: 100%; height: 280px; object-fit: cover; display: block;
        }

        .movie-info { padding: 14px; }
        .movie-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 4px; }

        /* Workspace Grid */
        .booking-workspace {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 30px;
            margin-bottom: 50px;
