            { id: 'bahubali', title: 'BAAHUBALI: THE CONCLUSION', price: 250.00, color: '#ffea00', format: 'IMAX RE-RELEASE', poster: 'https://images.unsplash.com/photo-1509198397868-475647b2a1e5?w=500&q=80' }
        ];

        let selectedLocation = 'Vijayawada';
        let selectedTheater = 'PVR Inox Cyberplex IMAX';
        let selectedShowtime = '2:30 PM';
        let selectedMovie = MOVIES[0];

        let selectedSeats = ['A1', 'A10'];
        const cornerSeats = ['A1', 'A10', 'B1', 'B10', 'C1', 'C10', 'D1', 'D10', 'E1', 'E10', 'F1', 'F10'];
        const occupiedSeats = ['B4', 'B5', 'D2', 'D3'];
        let snacks = { popcorn: 1, nachos: 1, drink: 2 };

        /* Audio Chime Engine */
        function playSuccessChime() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.1);
                    gain.gain.setValueAtTime(0.3, ctx.currentTime + idx * 0.1);
                    gain.gain.linearRampToValueAtTime(0.01, ctx.currentTime + idx * 0.1 + 0.2);
                    osc.connect(gain); gain.connect(ctx.destination);
                    osc.start(ctx.currentTime + idx * 0.1);
                    osc.stop(ctx.currentTime + idx * 0.1 + 0.2);
                });
            } catch(e) {}
        }

        function setUpiHandle(handle) {
            const input = document.getElementById('upiIdInput');
            let user = input.value.split('@')[0] || 'user';
            input.value = user + handle;
        }

        function updateTheaters() {
            selectedLocation = document.getElementById('locationSelect').value;
            const tSelect = document.getElementById('theaterSelect');
            tSelect.innerHTML = '';

            THEATERS[selectedLocation].forEach(t => {
                const opt = document.createElement('option');
                opt.value = t; opt.textContent = t;
                tSelect.appendChild(opt);
            });

            selectedTheater = THEATERS[selectedLocation][0];
            tSelect.onchange = () => { selectedTheater = tSelect.value; updateSummary(); };
            updateSummary();
        }

        function selectTimeSlot(btn, time) {
            document.querySelectorAll('.time-slot-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            selectedShowtime = time;
            updateSummary();
        }

        function renderMovies() {
            const grid = document.getElementById('moviesGrid');
            grid.innerHTML = '';
            MOVIES.forEach(m => {
                const isSelected = m.id === selectedMovie.id;
                const card = document.createElement('div');
                card.className = `movie-card ${isSelected ? 'selected' : ''}`;
                card.style.setProperty('--movie-theme-color', m.color);
                card.onclick = () => { selectedMovie = m; renderMovies(); updateSummary(); };
                card.innerHTML = `
                    <img src="${m.poster}" class="movie-poster" alt="${m.title}">
                    <div class="movie-info">
                        <div class="movie-title">${m.title}</div>
                        <div style="font-size:0.85rem; color:var(--accent-gold); font-weight:bold;">â‚¹${m.price.toFixed(2)}</div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function renderSeatMatrix() {
            const matrix = document.getElementById('seatMatrix');
            matrix.innerHTML = '';
            const rows = ['A', 'B', 'C', 'D', 'E', 'F'];
            rows.forEach(r => {
                const rowEl = document.createElement('div'); rowEl.className = 'seat-row';
                const label = document.createElement('div'); label.className = 'row-label'; label.textContent = r;
                rowEl.appendChild(label);

                for (let c = 1; c <= 10; c++) {
                    const seatId = `${r}${c}`;
                    const seatCell = document.createElement('div');
                    let classNames = 'seat-cell';
                    if (selectedSeats.includes(seatId)) classNames += ' selected';
                    if (occupiedSeats.includes(seatId)) classNames += ' occupied';
                    if (cornerSeats.includes(seatId)) classNames += ' corner';

                    seatCell.className = classNames; seatCell.textContent = c;
                    seatCell.onclick = () => toggleSeat(seatId);
                    rowEl.appendChild(seatCell);
                }
                matrix.appendChild(rowEl);
            });
        }

        function toggleSeat(seatId) {
            if (occupiedSeats.includes(seatId)) return;
            if (selectedSeats.includes(seatId)) selectedSeats = selectedSeats.filter(s => s !== seatId);
            else selectedSeats.push(seatId);
            renderSeatMatrix(); update3DSeats(); updateSummary();
        }

        function quickCornerSeats() { selectedSeats = ['A1', 'A10', 'F1', 'F10']; renderSeatMatrix(); update3DSeats(); updateSummary(); }
        function quickPrimeSeats() { selectedSeats = ['C5', 'C6', 'D5', 'D6']; renderSeatMatrix(); update3DSeats(); updateSummary(); }
        function clearSeats() { selectedSeats = []; renderSeatMatrix(); update3DSeats(); updateSummary(); }

        function updateSnack(type, change) {
            snacks[type] = Math.max(0, snacks[type] + change);
            document.getElementById('popcornQty').textContent = snacks.popcorn;
            document.getElementById('nachosQty').textContent = snacks.nachos;
            document.getElementById('drinkQty').textContent = snacks.drink;
            updateSummary();
        }

        function updateSummary() {
            document.getElementById('selectedMovieTitle').textContent = selectedMovie.title;
            document.getElementById('bookingSummaryText').textContent = `${selectedLocation} â€¢ ${selectedTheater} â€¢ ${selectedShowtime}`;

            let ticketBill = selectedSeats.length * selectedMovie.price;
            let snackBill = (snacks.popcorn * 220.0) + (snacks.nachos * 180.0) + (snacks.drink * 150.0);
            let grandTotal = ticketBill + snackBill;

            document.getElementById('selectedSeatsList').textContent = selectedSeats.length > 0 ? `${selectedSeats.join(', ')} (${selectedSeats.length} Seats) - â‚¹${ticketBill.toFixed(2)}` : 'No Seats Selected';
            document.getElementById('grandTotalText').textContent = `â‚¹${grandTotal.toFixed(2)}`;
            document.getElementById('payAmountText').textContent = `Total Amount: â‚¹${grandTotal.toFixed(2)}`;
        }

        /* 3D WebGL Seats Engine */
        let scene, camera, renderer, seatsGroup;
        function init3DAuditorium() {
            const container = document.getElementById('webgl-seats-canvas');
            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(60, container.clientWidth / container.clientHeight, 0.1, 100);
            camera.position.set(0, 10, 16); camera.lookAt(0, 0, -4);

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            container.appendChild(renderer.domElement);

            const screenMesh = new THREE.Mesh(new THREE.CylinderGeometry(18, 18, 7, 32, 1, true, -Math.PI / 4, Math.PI / 2), new THREE.MeshBasicMaterial({ color: 0x9d00ff, side: THREE.DoubleSide }));
            screenMesh.position.set(0, 3, -16); screenMesh.rotation.y = Math.PI; scene.add(screenMesh);

            seatsGroup = new THREE.Group(); scene.add(seatsGroup);
            update3DSeats();

            scene.add(new THREE.AmbientLight(0xffffff, 0.7));
            animate3D();
        }

        function update3DSeats() {
            if (!seatsGroup) return;
            seatsGroup.clear();
            const seatGeo = new THREE.BoxGeometry(0.75, 0.75, 0.75);
            ['A', 'B', 'C', 'D', 'E', 'F'].forEach((r, rIdx) => {
                for (let c = 1; c <= 10; c++) {
                    const isSelected = selectedSeats.includes(`${r}${c}`);
                    const seat = new THREE.Mesh(seatGeo, new THREE.MeshPhongMaterial({ color: isSelected ? 0xffb700 : 0x00f3ff }));
                    seat.position.set((c - 5.5) * 1.2, 0.5, (rIdx - 2.5) * 1.6);
                    seatsGroup.add(seat);
                }
            });
        }

        function animate3D() { requestAnimationFrame(animate3D); if (seatsGroup) seatsGroup.rotation.y = Math.sin(Date.now() * 0.0005) * 0.04; renderer.render(scene, camera); }

        function openPaymentModal() {
            const box = document.getElementById('paymentBoxInner');
            box.innerHTML = `
                <div style="font-family:'Orbitron'; font-size:1.2rem; color:var(--accent-cyan);">ONLINE UPI PAYMENT GATEWAY</div>
                <p style="color:#aaa; font-size:0.85rem; margin-top:4px;" id="payAmountText">Total Amount: ${document.getElementById('grandTotalText').textContent}</p>

                <div class="payment-methods">
                    <div class="pay-method active">ðŸ“± UPI (GPay/PhonePe)</div>
                    <div class="pay-method" style="opacity:0.6;">ðŸ’³ Card</div>
                    <div class="pay-method" style="opacity:0.6;">ðŸ¦ Net Banking</div>
                </div>

                <div id="upiFormSection" style="text-align:left; margin-top:15px;">
                    <label style="font-family:'Orbitron'; font-size:0.75rem; color:var(--accent-cyan);">ENTER YOUR UPI ID:</label>
                    <input type="text" id="upiIdInput" class="select-input" style="width:100%; margin-top:6px;" value="user@okaxis" placeholder="e.g. mobile@ybl / user@okaxis">
                    
                    <div style="display:flex; gap:6px; margin-top:8px;">
                        <button class="time-slot-btn" style="font-size:0.7rem; padding:4px 8px;" onclick="setUpiHandle('@okaxis')">@okaxis</button>
                        <button class="time-slot-btn" style="font-size:0.7rem; padding:4px 8px;" onclick="setUpiHandle('@ybl')">@ybl</button>
                        <button class="time-slot-btn" style="font-size:0.7rem; padding:4px 8px;" onclick="setUpiHandle('@paytm')">@paytm</button>
                        <button class="time-slot-btn" style="font-size:0.7rem; padding:4px 8px;" onclick="setUpiHandle('@ibl')">@ibl</button>
                    </div>
                </div>

                <button class="btn-checkout" id="payBtn" style="width:100%; background:linear-gradient(90deg, var(--accent-green), #00c853); color:#000;" onclick="processUpiPayment()">PAY NOW & GET E-TICKETS ðŸ”’</button>
            `;
            document.getElementById('paymentModal').classList.add('active');
        }

        /* PROCESS UPI PAYMENT WITH SPINNER & GREEN TICK ANIMATION */
        function processUpiPayment() {
            const upiId = document.getElementById('upiIdInput').value.trim();
            if (!upiId || !upiId.includes('@')) {
                alert('Please enter a valid UPI ID (e.g. user@okaxis)');
                return;
            }

            const box = document.getElementById('paymentBoxInner');
            
            // Phase 1: Verification Spinner
            box.innerHTML = `
                <div style="padding:20px 0;">
                    <div style="width:60px; height:60px; border:4px solid var(--accent-cyan); border-top-color:transparent; border-radius:50%; margin:0 auto; animation:spin 0.8s linear infinite;"></div>
                    <div style="font-family:'Orbitron'; margin-top:20px; color:var(--accent-cyan);">VERIFYING UPI ID (${upiId})...</div>
                    <p style="color:#aaa; font-size:0.8rem; margin-top:6px;">Requesting Payment Authorization from Bank...</p>
                </div>
                <style>@keyframes spin { 0%{transform:rotate(0deg);} 100%{transform:rotate(360deg);} }</style>
            `;

            // Phase 2: Green Tick Animation after 1.5 seconds!
            setTimeout(() => {
                playSuccessChime();
                box.innerHTML = `
                    <div style="padding:10px 0;">
                        <div class="green-tick-circle">
                            <svg class="checkmark-icon" viewBox="0 0 24 24">
                                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                            </svg>
                        </div>
                        <div style="font-family:'Orbitron'; font-size:1.4rem; color:var(--accent-green); margin-top:10px;">PAYMENT SUCCESSFUL!</div>
                        <p style="color:var(--accent-gold); font-family:'Orbitron'; margin-top:4px;">${document.getElementById('grandTotalText').textContent} PAID VIA ${upiId}</p>
                    </div>
                `;

                // Phase 3: Transition to Separated Dual E-Tickets after 1.5 seconds!
                setTimeout(() => {
                    document.getElementById('paymentModal').classList.remove('active');
                    showDualTickets();
                }, 1500);

            }, 1500);
        }

        function showDualTickets() {
            document.getElementById('t1MovieTitle').textContent = selectedMovie.title;
            document.getElementById('t1LocationTheater').textContent = `${selectedLocation} â€¢ ${selectedTheater}`;
            document.getElementById('t1Showtime').textContent = `SHOWTIME: ${selectedShowtime}`;
            document.getElementById('t1Seats').textContent = `SEATS: ${selectedSeats.join(', ')}`;
            let ticketBill = selectedSeats.length * selectedMovie.price;
            document.getElementById('t1Price').textContent = `TICKET BILL: â‚¹${ticketBill.toFixed(2)} (PAID via UPI)`;

            let snackItemsList = [];
            if (snacks.popcorn > 0) snackItemsList.push(`${snacks.popcorn}x Popcorn`);
            if (snacks.nachos > 0) snackItemsList.push(`${snacks.nachos}x Nachos`);
            if (snacks.drink > 0) snackItemsList.push(`${snacks.drink}x Cold Coffee`);
            
            document.getElementById('t2SnackItems').textContent = snackItemsList.length > 0 ? snackItemsList.join(', ') : 'No Snacks Ordered';
            let snackBill = (snacks.popcorn * 220.0) + (snacks.nachos * 180.0) + (snacks.drink * 150.0);
            document.getElementById('t2SnackPrice').textContent = `SNACK BILL: â‚¹${snackBill.toFixed(2)} (PAID via UPI)`;

            document.getElementById('ticketsModal').classList.add('active');
        }

        function closeTicketsModal() { document.getElementById('ticketsModal').classList.remove('active'); }

        updateTheaters(); renderMovies(); renderSeatMatrix(); init3DAuditorium(); updateSummary();
    </script>
