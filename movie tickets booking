        :root {
            --accent-cyan: #00f3ff;
            --accent-purple: #9d00ff;
            --accent-gold: #ffb700;
            --accent-pink: #ff007f;
            --accent-green: #00e676;
            --bg-dark: #070712;
            --card-bg: rgba(18, 18, 38, 0.75);
