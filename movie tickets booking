            box-shadow: 0 0 40px var(--accent-green);
            animation: pulseCheck 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes pulseCheck {
            0% { transform: scale(0); opacity: 0; }
