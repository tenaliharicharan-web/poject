        .auditorium-box {
            background: rgba(12, 12, 28, 0.9);
            border: 2px solid var(--border-glow);
            border-radius: 20px;
            padding: 20px;
        }

        .screen-preview-container {
            position: relative;
            width: 100%; height: 220px;
            border-radius: 12px;
            overflow: hidden;
            background: #000;
            margin-bottom: 15px;
        }

        #webgl-seats-canvas { width: 100%; height: 100%; display: block; }

        /* 2D Clickable Seat Grid */
