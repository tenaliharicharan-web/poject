            background: rgba(4, 4, 12, 0.92); backdrop-filter: blur(20px);
            display: flex; justify-content: center; align-items: center; z-index: 200;
            opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
        }

        .modal-overlay.active { opacity: 1; pointer-events: all; }

        .payment-box {
            width: 440px; background: rgba(18, 18, 40, 0.95); border: 2px solid var(--accent-cyan);
            border-radius: 24px; padding: 30px; text-align: center; box-shadow: 0 0 50px var(--accent-cyan);
